---
import Navbar from "./Navbar.astro";

interface Props {
  title: string;
}
const { title } = Astro.props;
---


<header class="m-2 flex justify-between text-white/85 bg-slate-900/80 px-5 py-2 sticky rounded-xl">
  <a href="/" class="font-ubuntu font-bold text-xl">{title}</a>
  <Navbar/>
</header>

